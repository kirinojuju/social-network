PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
SERVE_FRONTEND=false

# NOTE: if you have an older .env with a single DATABASE_URL (e.g. from a
# Neon connection string), split it into these PG* variables instead —
# the backend reads PGHOST/PGUSER/etc., not DATABASE_URL.
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#   -> PGUSER=USER, PGPASSWORD=PASSWORD, PGHOST=HOST, PGDATABASE=DBNAME, PGSSLMODE=require
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=social_network
PGUSER=social_app
PGPASSWORD=

# Prisma CLI only: direct/unpooled connection to your development database.
# Runtime uses PG* above; SQL migrations use MIGRATION_DATABASE_URL.
DIRECT_URL=
FIREBASE_PROJECT_ID=uniconnect-d5705
# Optional: requires Admin credentials; default token verification still checks
# signature, issuer, audience and expiry without this extra API lookup.
FIREBASE_CHECK_REVOKED=false
# Absolute path outside the repository; omit on hosts with managed credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# Migration owner connection only; never use this for the HTTP server.
MIGRATION_DATABASE_URL=

# AI assistant (OpenRouter) - get a key at https://openrouter.ai
OPENROUTER_API_KEY=
# Default model. If it fails (rate limit / daily quota, error, timeout, empty answer),
# the backend tries OPENROUTER_FALLBACK_MODELS in order. Free models rotate often.
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
# Optional: per-model wait in ms (default 15000) and how many models to try (default 3).
# OPENROUTER_TIMEOUT_MS=15000
# OPENROUTER_MAX_ATTEMPTS=3
