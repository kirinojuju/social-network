// Mirrors database/migrations/001 through 009. SQL migrations remain authoritative.
// Do not use Prisma Migrate or db push for this shared schema.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model faculties {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String   @unique
  majors majors[]
  users  users[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model majors {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  faculty_id String    @db.Uuid
  name       String
  faculties  faculties @relation(fields: [faculty_id], references: [id], onUpdate: NoAction)
  users      users[]

  @@unique([faculty_id, name])
  @@unique([id, faculty_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model media {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id      String   @db.Uuid
  owner_id     String   @db.Uuid
  storage_path String
  media_type   String
  mime_type    String
  file_size    BigInt
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  image_data   Bytes?
  users        users    @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts        posts    @relation(fields: [post_id, owner_id], references: [id, author_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([owner_id], map: "media_owner_idx")
  @@index([post_id], map: "media_post_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model posts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id  String   @db.Uuid
  content    String   @default("")
  visibility String   @default("private")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  legacy_firestore_id String?
  media      media[]
  post_likes post_likes[]
  post_comments post_comments[]
  users      users    @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, author_id])
  @@unique([author_id, legacy_firestore_id], map: "posts_author_legacy_key")
  @@index([author_id, created_at(sort: Desc), id(sort: Desc)], map: "posts_author_created_idx")
  @@index([created_at(sort: Desc), id(sort: Desc)], map: "posts_public_created_idx", where: raw("(visibility = 'public'::text)"))
}

model post_likes {
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@index([user_id], map: "post_likes_user_idx")
}

/// SQL migration enforces the nonempty comment and 2000 character limit.
model post_comments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String   @db.Uuid
  author_id  String   @db.Uuid
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([post_id, created_at, id], map: "post_comments_post_created_idx")
  @@index([author_id], map: "post_comments_author_idx")
}

/// SQL migration enforces the allowed image types and the 2 MB size limit.
model user_avatars {
  user_id    String   @id @db.Uuid
  mime_type  String
  image_data Bytes
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// SQL migration prevents members from following themselves.
model follows {
  follower_id String   @db.Uuid
  followee_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  follower    users    @relation("follower", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  followee    users    @relation("followee", fields: [followee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, followee_id])
  @@index([followee_id], map: "follows_followee_idx")
}

/// SQL migration requires text or a photo, enforces limits, and blocks messages to yourself.
model messages {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id       String    @db.Uuid
  recipient_id    String    @db.Uuid
  content         String    @default("")
  image_mime_type String?
  image_data      Bytes?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  read_at      DateTime? @db.Timestamptz(6)
  sender       users     @relation("sent_messages", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipient    users     @relation("received_messages", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sender_id, recipient_id, created_at(sort: Desc), id(sort: Desc)], map: "messages_sender_idx")
  @@index([recipient_id, sender_id, created_at(sort: Desc), id(sort: Desc)], map: "messages_recipient_idx")
}

model schema_migrations {
  name       String   @id
  checksum   String
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@ignore
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebase_uid String     @unique
  email        String
  username     String     @unique
  display_name String
  bio          String?
  avatar_url   String?
  faculty_id   String?    @db.Uuid
  major_id     String?    @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  media        media[]
  posts        posts[]
  post_likes   post_likes[]
  post_comments post_comments[]
  user_avatars user_avatars?
  following    follows[]  @relation("follower")
  followers    follows[]  @relation("followee")
  sent_messages     messages[] @relation("sent_messages")
  received_messages messages[] @relation("received_messages")
  faculties    faculties? @relation(fields: [faculty_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  majors       majors?    @relation(fields: [major_id, faculty_id], references: [id, faculty_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([faculty_id, major_id], map: "users_faculty_major_idx")
  @@index([major_id], map: "users_major_idx", where: raw("(major_id IS NOT NULL)"))
}
